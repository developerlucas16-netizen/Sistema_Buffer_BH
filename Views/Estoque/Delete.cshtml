@model Sistema_Buffer_BH.Models.EstoqueModel

@{
    ViewData["Title"] = "Delete";
}

<div class="d-flex justify-content-between align-items-center mt-2">
    <h1 class="ps-2">Excluir produto</h1>

    <a class="btn mx-5 fs-3 icone" asp-controller="Estoque" asp-action="Index"><i class="bi bi-x-square"></i></a>

</div>

<hr />

<div class="d-flex justify-content-center">
    <div class="card text-center bg-dark mb-3" style="width: 35rem; color:white; border-radius: 3rem;">
        <div class="card-body">
            <h2 class="card-title">Produto</h2>
            <hr />
            <p class="fs-4">Nome:    @Html.DisplayFor(model => model.Nome)</p>
            <p class="fs-4">Preço:   @Html.DisplayFor(model => model.Preco)</p>
            <p class="fs-4">Quantidade: @Html.DisplayFor(model => model.Quantidade)</p>
            <p class="fs-4">Código:  @Html.DisplayFor(model => model.Codigo)</p>
            <p class="fs-4">Fornecedor: @Html.DisplayFor(model => model.Fornecedor_Id)</p>
        </div>
    </div>
</div>

<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-center gap-3 mt-5">
            <button type="submit" class="btn btn-delete" style="width:20%">Excluir</button>
        </div>
    </form>
</div>