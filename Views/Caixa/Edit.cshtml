@model Sistema_Buffer_BH.Models.CaixaModel

@{
    ViewData["Title"] = "Editar Caixa";
}

<h1>Editar Caixa</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Forma" class="control-label"></label>
        <input asp-for="Forma" class="form-control" />
        <span asp-validation-for="Forma" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Valor" class="control-label"></label>
        <input asp-for="Valor" class="form-control" />
        <span asp-validation-for="Valor" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Salvar" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</form>