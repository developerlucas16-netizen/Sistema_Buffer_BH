<h2>Adiconar Movimentação</h2>

<form asp-action="AdicionarMovimentacao" method="post">

    <input type="hidden"
           name="caixaId"
           value="@Model.Id" />

    <div>
        <label>Descrição</label>
        <input type="text" name="descricao" />
    </div>

    <div>
        <label>Tipo</label>

        <select name="tipo">
            <option value="Entrada">Entrada</option>
            <option value="Saida">Saída</option>
        </select>
    </div>

    <div>
        <label>Valor</label>
        <input type="number"
               step="0.01"
               name="valor" />
    </div>

    <button type="submit">
        Adicionar Movimentação
    </button>
</form>