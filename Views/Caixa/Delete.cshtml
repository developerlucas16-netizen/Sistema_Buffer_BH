@model Sistema_Buffer_BH.Models.CaixaModel

@{
    ViewData["Title"] = "Excluir Caixa";
}

<h1>Excluir Caixa</h1>

<h3>Tem certeza que deseja excluir isso?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Forma
        </dt>
        <dd class="col-sm-10">
            @Model.Forma
        </dd>

        <dt class="col-sm-2">
            Valor
        </dt>
        <dd class="col-sm-10">
            @Model.Valor
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>