@model  Sistema_Buffer_BH.Models.CaixaModel

<div class="d-flex justify-content-between align-items-center mt-2">
    <h1 class="">Caixa</h1>

    <a class="btn mx-4 icone" asp-controller="Caixa" asp-action="AdicionarMovimentacao"><i class="bi bi-cash-coin fs-3"></i>+</a>

</div>

<hr />

<div class="row g-3 justify-content-center">

    <div class="col-10 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100">
            <div class="card-body text-center">
                <h3 class="fs-6">Caixa Inicial</h3>
                <p class="fs-5 fw-bold mb-0">
                    R$ @Model.ValorInicial
                </p>
            </div>
        </div>
    </div>

    <div class="col-10 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100">
            <div class="card-body text-center">
                <h3 class="fs-6">Total Entradas</h3>
                <p class="fs-5 fw-bold text-success mb-0">
                    R$ @Model.TotalEntradas
                </p>
            </div>
        </div>
    </div>

    <div class="col-10 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100">
            <div class="card-body text-center">
                <h3 class="fs-6">Total Saídas</h3>
                <p class="fs-5 fw-bold text-danger mb-0">
                    R$ @Model.TotalSaidas
                </p>
            </div>
        </div>
    </div>

    <div class="col-10 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100">
            <div class="card-body text-center">
                <h3 class="fs-6">Lucro</h3>
                <p class="fs-5 fw-bold text-primary mb-0">
                    R$ @Model.Lucro
                </p>
            </div>
        </div>
    </div>
</div>

<hr />

<form asp-action="FecharCaixa" method="post">

    <input type="hidden"
        name="caixaId"
        value="@Model.Id" />

    <button type="submit" class="btn btn-outline-danger">
        Fechar Caixa
    </button>
</form>

<hr />

<h2>Movimentações do dia</h2>

<table border="1">
    <thead>
        <tr>
            <th>Hora</th>
            <th>Descrição</th>
            <th>Tipo</th>
            <th>Valor</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Movimentacao)
        {
            <tr>
                <td>@item.Data.ToString("HH:mm")</td>
                <td>@item.Descricao</td>
                <td>@item.Tipo</td>
                <td>R$ @item.Valor</td>
            </tr>
        }

    </tbody>
</table>