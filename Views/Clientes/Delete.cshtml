@model Sistema_Buffer_BH.Models.ClientesModel

@{
    ViewData["Title"] = "Delete";
}

<div class="d-flex justify-content-between align-items-center mt-2">
    <h1 class="ps-2">Excluir Cliente</h1>

    <a class="btn mx-5 fs-3 icone" asp-controller="Clientes" asp-action="Index"><i class="bi bi-x-square"></i></a>
</div>

<hr />

<div class="d-flex justify-content-center">
    <div class="card text-center bg-dark mb-3" style="width: 35rem; color:white; border-radius: 3rem;">
        <div class="card-body">
            <h2 class="card-title">Produto</h2>
            <hr />
            <p class="fs-4">Nome:    @Html.DisplayFor(model => model.Nome)</p>
            <p class="fs-4">CPF:   @Html.DisplayFor(model => model.CPF)</p>
            <p class="fs-4">Telefone: @Html.DisplayFor(model => model.Telefone)</p>
            <p class="fs-4">Email:  @Html.DisplayFor(model => model.Email)</p>
        </div>
    </div>
</div>

<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-center gap-3 mt-5">
            <button type="submit" class="btn btn-delete" style="width:20%">Excluir</button>
        </div>
    </form>
</div>