@model IEnumerable<Sistema_Buffer_BH.Models.ClientesModel>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mt-2">
    <h1 class="ps-2">Clientes</h1>

    <a class="btn mx-5 icone" asp-controller="Clientes" asp-action="Create"><i class="bi bi-person-plus fs-3"></i></a>

</div>

<hr />

<div class="container">

    <table id="Cliente" class="table table-dark table-striped mt-5 caption-top">
        <caption>
            <div class="row g-3">
                <div class="col-sm-7">
                    <h2>Lista de Produtos</h2>
                </div>
                <div class="col-sm">
                </div>
                <div class="col-sm">
                    <input type="text" id="filtro" class="form-control mb-2" placeholder="Pesquisar...">
                </div>
            </div>
        </caption>
        <thead>
            <tr>
                <th scope="col">Nome</th>
                <th scope="col">Telefone</th>
                <th scope="col">Email</th>
                <th scope="col">CPF</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody class="table-group-divider" id="tabela">
            @if (Model != null)
            {

                @foreach (var clientes in Model)

                {
                    <tr>
                        <td scope="row">@clientes.Nome</td>
                        <td scope="row">@clientes.Telefone</td>
                        <td scope="row">@clientes.Email</td>
                        <td scope="row">@clientes.CPF</td>
                        <td>
                            <!--EDITAR-->
                            <a class="btn text-white mx-2 float-end" asp-action="Edit"
                               asp-route-id="@clientes.Id"><i class="bi bi-pencil"></i></a>
                            <!--EXCLUIR-->
                            <a class="btn text-white mx-2 float-end" asp-action="Delete"
                               asp-route-id="@clientes.Id"><i class="bi bi-trash-fill"></i></a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>



<!-- Paginação Bootstrap -->
<nav>
    <ul class="pagination justify-content-center" id="paginacao"></ul>
</nav>

<script>
       const linhasPorPagina = 6;
    let paginaAtual = 1;

    const linhas = Array.from(document.querySelectorAll("#tabela tr"));

    function mostrarPagina(pagina) {
        paginaAtual = pagina;

        const inicio = (pagina - 1) * linhasPorPagina;
        const fim = inicio + linhasPorPagina;

        linhas.forEach((linha, index) => {
            linha.style.display = (index >= inicio && index < fim) ? "" : "none";
        });

        renderizarPaginacao();
    }

    function renderizarPaginacao() {
        const totalPaginas = Math.ceil(linhas.length / linhasPorPagina);
        const paginacao = document.getElementById("paginacao");

        paginacao.innerHTML = "";

        for (let i = 1; i <= totalPaginas; i++) {
            let li = document.createElement("li");
            li.className = "page-item " + (i === paginaAtual ? "active" : "");

            let a = document.createElement("a");
            a.className = "page-link";
            a.innerText = i;
            a.href = "#";
            a.onclick = (e) => {
                e.preventDefault();
                mostrarPagina(i);
            };

            li.appendChild(a);
            paginacao.appendChild(li);
        }
    }


    // 🔍 Filtro funcionando junto
    document.getElementById("filtro").addEventListener("keyup", function () {
        const valor = this.value.toLowerCase();

        linhas.forEach(linha => {
            const texto = linha.textContent.toLowerCase();
            linha.style.display = texto.includes(valor) ? "" : "none";
        });

        // reinicia paginação após filtro
        paginaAtual = 1;
        renderizarPaginacao();
    });

    // inicialização
    mostrarPagina(1);
</script>