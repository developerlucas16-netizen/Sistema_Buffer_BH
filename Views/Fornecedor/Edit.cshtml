@model Sistema_Buffer_BH.Models.FornecedorModel

@{
    ViewData["Title"] = "Edit";
}

<div class="d-flex justify-content-between align-items-center mt-2">
    <h1 class="ps-2">Editar Fornecedores</h1>

    <a class="btn mx-5 fs-3 icone" asp-controller="Fornecedor" asp-action="Index"><i class="bi bi-x-square"></i></a>
</div>
<hr />
<div class="container-fluid">
    <div class="row align-items-center">
        <div class="col-xl-2 col-sm-2">
            <!--LADO ESQUERDO-->
        </div>
        <div class="col-xl-8 col-sm-8 bg-dark p-5" id="teste">
            <!--CENTRO-->
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-12 form-group text-white">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-center gap-3 mt-5">
                    <button type="submit" class="btn btn-edit w-50">Salvar</button>

                </div>
            </form>
        </div>
        <div class="col-xl-2 col-sm-2">
            <!--LADO DIREITO-->
        </div>
    </div>
</div>

<style>
    #teste {
        opacity: 0.8;
        border-radius: 15px;
    }
</style>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}